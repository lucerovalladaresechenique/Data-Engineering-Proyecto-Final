# --- GCP: mismos recursos del proyecto de asistencia ---
GCP_PROJECT=proyecto-final-505619
GCS_BUCKET=proyecto-final-505619-asistencia
BQ_DATASET=gold

# --- Nombres de tabla (confirmados: star schema) ---
TABLA_DIM_EMPLEADO=dim_empleado
TABLA_FACT_ASISTENCIA=fact_asistencia_diaria
TABLA_FACT_AUSENTISMO=fact_ausentismo

# --- Fuente de datos: bigquery | parquet ---
DATA_SOURCE=bigquery
LOCAL_PARQUET_GLOB=data/gold/fact_asistencia_diaria*.parquet
LOCAL_PARQUET_AUSENTISMO_GLOB=data/gold/fact_ausentismo*.parquet

# --- Cache ---
CACHE_TTL_SECONDS=300

# --- Credenciales GCP (ruta al service account key, o vacío si usas ADC) ---
GOOGLE_APPLICATION_CREDENTIALS=
